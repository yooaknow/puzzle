# 이 파일을 .env.local로 복사하고 값을 채운다. (Vercel에서는 프로젝트 환경 변수에 같은 이름으로 넣는다)
# Supabase 대시보드 > Project Settings > API 에서 확인할 수 있다.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key(sb_publishable_...) 또는 예전 anon key. 비밀 키(service_role, sb_secret_...)는 절대 넣지 않는다.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
